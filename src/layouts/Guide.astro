---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AdSlot from '../components/AdSlot.astro';
import { getTool } from '../data/tools';
import { articleSchema, breadcrumbSchema, type Crumb } from '../lib/schema';

export interface Props {
  title: string;
  description: string;
  h1: string;
  blurb: string;
  slug: string;
  kicker?: string;
  sourceNote?: string;
  published: string;
  updated?: string;
  relatedTools: string[];
  /** Rough word count of the rendered body, for the reading-time estimate. */
  words?: number;
  /** Top-level headings, taken from Astro's own render() output. */
  toc?: { id: string; label: string }[];
}

const {
  title,
  description,
  h1,
  blurb,
  slug,
  kicker = 'Guide',
  sourceNote,
  published,
  updated,
  relatedTools,
  words,
  toc = [],
} = Astro.props;
const path = `/guides/${slug}/`;

const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  { name: 'Guides', path: '/guides/' },
  { name: h1, path },
];

const tools = relatedTools.map(getTool);

/*
  Reading time is computed from the actual body, never hand-written in
  frontmatter — a number an author has to remember to update is a number that
  is wrong within a month. 200 wpm is the usual figure for online prose.
*/
const minutes = words ? Math.max(1, Math.round(words / 200)) : null;

const shownDate = updated && updated !== published ? updated : published;
const dateLabel = updated && updated !== published ? 'Updated' : 'Published';

/** "2026-08-07" → "7 August 2026". Rendered at build time, so no client cost. */
const prettyDate = new Date(`${shownDate}T00:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title={title}
  description={description}
  path={path}
  type="article"
  publishedTime={published}
  modifiedTime={updated ?? published}
  schema={[
    articleSchema({ headline: h1, description, path, published, updated }),
    breadcrumbSchema(crumbs),
  ]}
>
  <Breadcrumbs crumbs={crumbs} />

  <div class="with-rail" style="margin-top: 0">
    <article class="with-rail__main">
      <header class="page-head">
        <p class="eyebrow">{kicker === 'Guide' ? 'Guide' : `Guide · ${kicker}`}</p>
        <h1 style="max-width: 22ch">{h1}</h1>
        <p class="page-head__blurb">{blurb}</p>

        {/*
          Stating the date, the length and where the numbers came from, in the
          open. Platform specs go stale constantly and almost no competitor
          says when they last checked — being the one that does is cheap, and
          it is exactly the kind of detail that earns a link.
        */}
        <p class="byline">
          <span>{dateLabel} <time datetime={shownDate}>{prettyDate}</time></span>
          {minutes && <span>· {minutes} min read</span>}
          {sourceNote && <span>· {sourceNote}</span>}
        </p>
      </header>

      <div class="prose">
        <slot />
      </div>

      <AdSlot placement="inArticle" />

      {
        tools.length > 0 && (
          <section class="related">
            <h2>Tools this guide refers to</h2>
            <ul class="tool-grid">
              {tools.map((tool) => (
                <li>
                  <a class="tool-card" href={`/${tool.slug}/`}>
                    <span class="tool-card__name">{tool.name}</span>
                    <span class="tool-card__desc">{tool.blurb.split('.')[0]}.</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>

    <aside class="rail" aria-label="Contents and related tools">
      {
        toc.length > 2 && (
          <nav class="rail-card">
            <p class="rail-card__head">Contents</p>
            <ul>
              {toc.map((item) => (
                <li>
                  <a href={`#${item.id}`}>{item.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        tools.length > 0 && (
          <div class="rail-card rail-card--ink">
            <p class="rail-card__head">Tools in this guide</p>
            <ul>
              {tools.map((tool) => (
                <li>
                  <a href={`/${tool.slug}/`}>{tool.name}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="rail-card">
        <p class="rail-card__head">More guides</p>
        <ul>
          <li><a href="/guides/">All guides</a></li>
          <li><a href="/">Every tool</a></li>
        </ul>
      </div>

      <AdSlot placement="inArticle" variant="halfpage" class="rail__desktop-only" />
    </aside>
  </div>

  <AdSlot placement="belowContent" variant="leaderboard" />
</Base>
