---
import { SITE } from '../config';
import { CATEGORIES } from '../data/tools';

const path = Astro.url.pathname;

const navItems = [
  ...CATEGORIES.map((c) => ({ href: `/${c.slug}/`, label: c.name })),
  { href: '/guides/', label: 'Guides' },
];

const isCurrent = (href: string) => path === href;
---

<header class="site-header">
  <div class="container site-header__inner">
    {/*
      The mark is a solid ink square with a notch bitten out of the
      bottom-right — a crop handle, reduced to the point where it still reads
      at 26px. Drawn with CSS (see .brand__mark) rather than SVG so it inherits
      the theme instead of carrying a second, drifting colour definition.
    */}
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true"></span>
      {SITE.name}
    </a>

    {/* Desktop navigation — real anchors, always in the HTML */}
    <nav class="nav" aria-label="Primary">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/*
      Mobile navigation uses <details>, so it opens and closes with no
      JavaScript at all. The links are in the static HTML either way, which
      keeps them crawlable — a JS-only menu risks Google not following them.
    */}
    <details class="mobile-nav">
      <summary aria-label="Open menu">
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
        Menu
      </summary>
      <div class="mobile-nav__panel">
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </details>
  </div>
</header>
