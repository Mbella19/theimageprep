---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/Guide.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
---

<GuideLayout
  title={guide.data.title}
  description={guide.data.description}
  h1={guide.data.h1}
  blurb={guide.data.blurb}
  slug={guide.id}
  published={guide.data.published}
  updated={guide.data.updated}
  relatedTools={guide.data.relatedTools}
>
  <Content />
</GuideLayout>
