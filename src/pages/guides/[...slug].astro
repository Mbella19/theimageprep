---
import { getCollection, render } from 'astro:content';
import GuideLayout from '../../layouts/Guide.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

/*
  Contents for the sticky rail. Astro already slugs every markdown heading
  into an `id`, and `render()` hands back the same list it used — so this
  cannot drift out of sync with the page the way a hand-written TOC would.

  Only h2s. Including h3s turns a nine-item list into a thirty-item one and
  stops being navigation.
*/
const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));

/*
  Word count for the reading-time estimate, taken from the raw Markdown at
  build time. Stripping fences, tags and link syntax first keeps a
  code-heavy guide from reporting a wildly inflated length.
*/
const words = (guide.body ?? '')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/[#>*_`|-]/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
---

<GuideLayout
  title={guide.data.title}
  description={guide.data.description}
  h1={guide.data.h1}
  blurb={guide.data.blurb}
  slug={guide.id}
  kicker={guide.data.kicker}
  sourceNote={guide.data.sourceNote}
  published={guide.data.published}
  updated={guide.data.updated}
  relatedTools={guide.data.relatedTools}
  words={words}
  toc={toc}
>
  <Content />
</GuideLayout>
